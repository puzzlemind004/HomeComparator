# Dependencies and AdonisJS build
node_modules
build
tmp

# Les fichiers de photos du développement hors conteneur (#13). En production
# ils vivent sur un volume Docker, jamais dans le dépôt : git versionnerait
# chaque binaire éternellement, sans purge possible (ADR-0007).
stockage

# Secrets : tous les fichiers d'environnement sauf l'exemple documenté
.env
.env.*
!.env.example
!.env.test.example

# Frontend assets compiled code
public/assets

# Schéma généré par Lucid à chaque `migration:run` en développement. Il n'est
# régénéré ni par les tests (`--no-schema-generate`) ni au démarrage du
# conteneur (court-circuité hors développement) : le versionner reviendrait à
# garder une seconde description de `biens`, non garantie, à côté des modèles
# de `app/models/` qui font foi (ADR-0004).
database/schema.ts

# Index des routes et des imports, que `node ace` régénère à chaque commande —
# tests compris. Il décrit l'état de `start/routes.ts` et des contrôleurs, qui
# font foi : le versionner donnerait une seconde description à tenir d'accord
# avec la première, et un diff à chaque lancement de tests.
.adonisjs

# Build tools specific
npm-debug.log
yarn-error.log

# Editors specific
.fleet
.idea
.vscode

# Platform specific
.DS_Store
