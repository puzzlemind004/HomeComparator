# Copier ce fichier vers .env et renseigner les valeurs.
# Aucun secret réel ne doit être versionné.

TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Clé de chiffrement de l'application (32 caractères).
# Générer avec : openssl rand -base64 24
APP_KEY=

# Base de données PostgreSQL.
# Ces valeurs sont celles du développement local : l'API tourne sur la
# machine hôte et joint PostgreSQL par le port publié du conteneur
# (5433 par défaut, voir POSTGRES_PORT dans le .env de la racine).
# En conteneur, docker-compose.yml impose DB_HOST=postgres et DB_PORT=5432 ;
# ce fichier n'est pas lu dans ce cas.
DB_HOST=localhost
DB_PORT=5433
DB_USER=homecomparator
DB_PASSWORD=
DB_DATABASE=homecomparator

# Origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGIN=http://localhost:4200

# Mot de passe unique protégeant l'accès à l'outil.
# Un seul utilisateur : ni comptes, ni inscription, ni réinitialisation.
# Le changer ne déconnecte pas les sessions ouvertes, qui vivent en base :
# vider la table `sessions` le fait, et c'est le geste si le mot de passe a fui.
APP_PASSWORD=

# Racine du stockage des photos (#13).
# En développement hors conteneur, un dossier de la machine hôte : laissé
# vide, l'API écrit dans `apps/api/stockage/photos`, que git ignore.
# En conteneur, docker-compose.yml impose /app/stockage/photos, monté sur un
# volume ; ce fichier n'est pas lu dans ce cas.
STOCKAGE_PHOTOS=

# Version déployée, rendue par la route de santé à un appelant muni d'une
# session (#67). Laissée vide, l'API se dit en `dev` : hors conteneur il n'y
# a pas d'image à désigner. En production c'est le `Dockerfile` qui la fige,
# depuis l'argument de construction que le déploiement renseigne.
APP_VERSION=

# Fichier où la sauvegarde quotidienne dépose la date de sa dernière réussite,
# que la route de santé lit et rend à un appelant muni d'une session (#67,
# ADR-0007). Laissé vide, l'API le cherche dans `apps/api/stockage/`, que git
# ignore — hors conteneur rien ne sauvegarde, et la route rend l'absence.
# En conteneur, docker-compose.yml impose /app/sauvegardes/derniere-sauvegarde,
# monté en lecture seule sur un volume partagé avec la sauvegarde.
HORODATAGE_SAUVEGARDE=
