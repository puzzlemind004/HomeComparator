# Copier vers .env.test : configuration des tests fonctionnels.
# Adonis charge .env.test par-dessus .env quand NODE_ENV=test.
# Ce fichier est versionné ; .env.test ne l'est pas.

NODE_ENV=test
TZ=UTC
PORT=3334
HOST=localhost
LOG_LEVEL=silent

# Clé de test : sans valeur réelle, aucune donnée de production n'en dépend.
APP_KEY=cle-de-test-de-trente-deux-carac

# Base DISTINCTE de celle de développement, créée automatiquement à
# l'initialisation du volume PostgreSQL (docker/postgres/init-test-db.sh).
#
# La base tourne dans le conteneur, joint sur la boucle locale (#18). Ses
# identifiants sont ceux du .env racine, qui fait foi : y recopier
# POSTGRES_PASSWORD, propre à chaque installation depuis qu'il se génère.
DB_HOST=localhost
DB_PORT=5433
DB_USER=homecomparator
DB_PASSWORD=
DB_DATABASE=homecomparator_test

CORS_ORIGIN=http://localhost:4200

# Mot de passe des tests : les tests de connexion s'y réfèrent par
# `env.get('APP_PASSWORD')` plutôt que de le recopier.
APP_PASSWORD=mot-de-passe-de-test

# Racine du stockage des photos pendant les tests : un dossier à part,
# vidé entre les tests, pour que ceux-ci ne touchent jamais le volume réel.
STOCKAGE_PHOTOS=./tmp/photos-test

# Horodatage de la dernière sauvegarde réussie pendant les tests : un
# fichier à part, écrit et effacé par les tests eux-mêmes (#67).
HORODATAGE_SAUVEGARDE=./tmp/derniere-sauvegarde-test
