# Copier vers .env.test : configuration des tests fonctionnels.
# Adonis charge .env.test par-dessus .env quand NODE_ENV=test.
# Ce fichier est versionné ; .env.test ne l'est pas.

NODE_ENV=test
TZ=UTC
PORT=3334
HOST=localhost
LOG_LEVEL=silent

# Clé de test : sans valeur réelle, aucune donnée de production n'en dépend.
APP_KEY=cle-de-test-de-trente-deux-carac

# Base DISTINCTE de celle de développement, créée automatiquement à
# l'initialisation du volume PostgreSQL (docker/postgres/init-test-db.sh).
DB_HOST=localhost
DB_PORT=5433
DB_USER=homecomparator
DB_PASSWORD=homecomparator
DB_DATABASE=homecomparator_test

CORS_ORIGIN=http://localhost:4200
